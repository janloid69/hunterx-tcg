# HunterX Discord bot settings.
# Copy this file to .env (same folder) and fill in the two secrets.
# Never share .env or paste these secrets anywhere, including chats.

# Secret 1: Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Secret 2: Supabase -> Project Settings -> API Keys -> Secret keys
# (create one named "discord-bot"; it starts with sb_secret_)
SUPABASE_SECRET_KEY=

