# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API). Both values are safe to ship in a website.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Invite link shown to members who are not in the HunterX Discord yet
EXPO_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/R4MvMDex8a
